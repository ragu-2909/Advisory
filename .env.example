NODE_ENV=development
HOST=127.0.0.1
PORT=4100
LOG_LEVEL=info
DATABASE_URL=postgresql://advisory:change-me@localhost:5432/advisory

# CrowdStrike Falcon US-2. Add credentials only on the server.
CROWDSTRIKE_BASE_URL=https://api.us-2.crowdstrike.com
CROWDSTRIKE_CLIENT_ID=
CROWDSTRIKE_CLIENT_SECRET=
CROWDSTRIKE_HOST_CACHE_SECONDS=900

# Optional but recommended for production NVD rate limits.
NVD_API_KEY=
CVE_REPO_PATH=
DEFAULT_ALERT_CONSUMER=fusion-prod

# Scheduler controls
ENABLE_SCHEDULERS=true
KEV_CRON=*/20 * * * *
EPSS_CRON=15 20 * * *
CVE_CRON=*/10 * * * *
